# QITL environment. Copy to .env.local for development. Never commit real values.

# Public site address (canonical URLs, sitemap, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project settings → API). The anon/publishable key is safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used for account deletion and trusted import jobs. Never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=
# SERVER ONLY. Direct Postgres connection for migrations (supabase db push) and scripts.
DATABASE_URL=

# Map tiles (raster XYZ template, e.g. https://tiles.example.com/{z}/{x}/{y}.png). Leave empty to keep the map off.
# If the provider needs a key, use a public, domain-restricted token inside the URL; MAP_TILES_URL maps to this variable.
NEXT_PUBLIC_MAP_TILES_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Optional: show "Continue with Google" (enable the provider in Supabase Auth first)
NEXT_PUBLIC_AUTH_GOOGLE=0

# Email (Supabase Auth sends sign-in links with its SMTP settings; digests use this sender). Server only.
EMAIL_FROM=

# ---------- Interpretation Explorer: source adapters and AI-assisted drafts (all SERVER ONLY, all optional) ----------
# Import scripts (scripts/import-*.ts) refuse to run without --accept-terms and a verified, licence-cleared edition.
# QuranEnc translations (scripts/import-translation.ts --provider quranenc)
QURANENC_API_KEY=
# Quran Foundation Content API (OAuth2 client credentials; --provider quran_foundation)
QF_CLIENT_ID=
QF_CLIENT_SECRET=
# sunnah.com hadith API (scripts/import-hadith.ts)
SUNNAH_API_KEY=
# Claude for AI-assisted explanation DRAFTS (POST /api/admin/interpretation/draft). Unset = the route is off.
ANTHROPIC_API_KEY=
# Optional model override (default claude-opus-5-5)
ANTHROPIC_MODEL=

# ---------- Media Library uploads (SERVER ONLY, optional) ----------
# Malware scanner endpoint: each upload is POSTed as application/octet-stream and must answer
# {"result":"clean"|"infected","engine"?:string}. Unset = uploads stay in the private pending/ folder until an admin
# acknowledges "scan skipped". Recording scan results also needs SUPABASE_SERVICE_ROLE_KEY.
MALWARE_SCAN_URL=
# Optional bearer token sent to the scanner
MALWARE_SCAN_TOKEN=
# ---------- Security and operations (docs/SECURITY.md, docs/OPERATIONS.md; all optional) ----------
# Content-Security-Policy mode: enforce (default) or report-only (trial a policy change; violations go to /api/csp-report).
CSP_MODE=enforce
# HTTP rate limits (per IP in the middleware, per user in requireUser). Store: memory (default, per instance) or upstash
# (any Upstash-compatible Redis REST endpoint, shared by all instances; set both values below).
RATE_LIMIT_STORE=
UPSTASH_REDIS_REST_URL=
# SERVER ONLY.
UPSTASH_REDIS_REST_TOKEN=
# Per-bucket overrides, "<requests>/<seconds>": API, SEARCH, MUTATION, TOKEN, REPORT, USER, USER_MUTATION.
# RATE_LIMIT_SEARCH=60/60
# 1 turns the HTTP limits off (the database throttle always stays on).
RATE_LIMIT_DISABLED=
# Error tracking: a Sentry (or GlitchTip / self-hosted Sentry) DSN. Empty = errors are only logged. Server only;
# scrubbed: no bodies, query strings, emails, ids or private dream/mufti text are ever sent.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# Privacy-safe analytics collector (POST JSON {event, path, locale}). Empty = no analytics at all (the default).
NEXT_PUBLIC_ANALYTICS_URL=
